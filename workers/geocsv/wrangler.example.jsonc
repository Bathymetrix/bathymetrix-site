{
  // Use as a template for approved deployment configuration outside this checkout.
  "name": "bathymetrix-geocsv",
  "main": "src/index.js",
  "compatibility_date": "2026-10-22",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "bathymetrix.com/geocsv/*", "zone_name": "bathymetrix.com" }],
  "r2_buckets": [{ "binding": "GEOCSV", "bucket_name": "REPLACE_WITH_APPROVED_BUCKET" }]
}
